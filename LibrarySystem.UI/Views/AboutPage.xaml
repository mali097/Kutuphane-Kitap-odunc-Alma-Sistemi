<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LibrarySystem.UI.Views.AboutPage"
             Title="Hakkımızda"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2F1B68" Offset="0.0" />
            <GradientStop Color="#B63B6E" Offset="0.55" />
            <GradientStop Color="#F29B3A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              Background="{StaticResource HeaderGradient}"
              Padding="14,48,14,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="←"
                        FontSize="20"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="4"
                        Clicked="Back_Clicked" />
                <Label Grid.Column="1"
                       Text="Hakkımızda"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,24" Spacing="16">

                <Border Style="{StaticResource ThemedCard}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="📖"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Biz Kimiz?"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                        </HorizontalStackLayout>

                        <Label Text="Kitapların iyileştirici ve birleştirici gücüne inanan bir ekibiz. Bu uygulamayı, kitapseverlerin aradıkları dünyalara çok daha rahat ulaşabilmesi, kütüphane deneyimini dijital çağın hızına ve estetiğine uydurabilmesi için tasarladık."
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}" />

                        <Label Text="Amacımız, sadece bir kitap ödünç alma platformu olmak değil; okuma kültürünü yaygınlaştırmak ve her yaştan okuru en doğru kaynaklarla buluşturmaktır. Yolculuğumuza ortak olduğunuz için teşekkür ederiz."
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}" />

                        <Label Text="Keyifli okumalar dileriz!"
                               FontSize="14"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPurpleColorLight}, Dark={StaticResource AccentPurpleColorDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ThemedCard}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="ℹ️"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Hakkımızda"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                        </HorizontalStackLayout>

                        <Label Text="Platformumuz, modern kütüphanecilik anlayışını dijital dünyaya taşıyan yenilikçi bir kütüphane yönetim ve kitap paylaşım sistemidir."
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}" />

                        <Label Text="Kullanıcı dostu arayüzümüz sayesinde binlerce kitaba anında göz atabilir, kategorileri keşfedebilir ve dilediğiniz eseri saniyeler içinde ödünç alabilirsiniz. Okuma alışkanlıklarınızı dijitalleştiren ve kolaylaştıran çözümler üretmeye devam ediyoruz."
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ThemedCard}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="🎯"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Misyonumuz"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                        </HorizontalStackLayout>

                        <Label Text="Bilgiye ve edebiyata erişimi sınırları kaldırarak kolaylaştırmak; teknolojiyi kullanarak okurları ve kitapları en pratik şekilde bir araya getirmek."
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ThemedCard}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="🚀"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Vizyonumuz"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                        </HorizontalStackLayout>

                        <Label Text="Gelişmiş arayüz ve kullanıcı deneyimiyle, kitapseverlerin ilk adresi haline gelerek dijital kütüphanecilik standartlarını yukarı taşımak."
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
