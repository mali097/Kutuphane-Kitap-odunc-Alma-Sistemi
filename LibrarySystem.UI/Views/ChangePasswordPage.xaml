<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LibrarySystem.UI.Views.ChangePasswordPage"
             Title="Şifre değiştir"
             BackgroundColor="#141624"
             Shell.BackgroundColor="#2B1B4F"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Center">

            <Label Text="Hesabının şifresini güncelle. Güçlü bir şifre kullan."
                   TextColor="#9FA8DA"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   Margin="0,0,0,8" />

            <Border BackgroundColor="#2B1B4F"
                    Stroke="#FFFFFF22"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mevcut şifre" TextColor="#B0B8D9" FontSize="12" />
                        <Entry x:Name="OldPasswordEntry"
                               IsPassword="True"
                               TextColor="White"
                               PlaceholderColor="#7C86B3"
                               BackgroundColor="#1E1638"
                               Placeholder="••••••••" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Yeni şifre (en az 6 karakter)" TextColor="#B0B8D9" FontSize="12" />
                        <Entry x:Name="NewPasswordEntry"
                               IsPassword="True"
                               TextColor="White"
                               PlaceholderColor="#7C86B3"
                               BackgroundColor="#1E1638"
                               Placeholder="••••••••" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Yeni şifre tekrar" TextColor="#B0B8D9" FontSize="12" />
                        <Entry x:Name="ConfirmPasswordEntry"
                               IsPassword="True"
                               TextColor="White"
                               PlaceholderColor="#7C86B3"
                               BackgroundColor="#1E1638"
                               Placeholder="••••••••" />
                    </VerticalStackLayout>
                    <Label x:Name="ErrorLabel"
                           TextColor="#FFAB91"
                           FontSize="13"
                           IsVisible="False"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Şifreyi güncelle"
                    BackgroundColor="#6E5BFF"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="52"
                    FontAttributes="Bold"
                    Clicked="Change_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
