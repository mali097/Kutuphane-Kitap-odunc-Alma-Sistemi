<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LibrarySystem.UI.Views.UserPanelPage"
             Title="Profil"
             BackgroundColor="#141624"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="#2B1B4F"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="ProfileHeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2F1B68" Offset="0.0" />
            <GradientStop Color="#B63B6E" Offset="0.55" />
            <GradientStop Color="#F29B3A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                StrokeThickness="0"
                Background="{StaticResource ProfileHeaderBrush}"
                Padding="20,20,20,24">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto">
                <Border Grid.RowSpan="3"
                        WidthRequest="72"
                        HeightRequest="72"
                        Stroke="#FFFFFF44"
                        StrokeShape="RoundRectangle 36"
                        BackgroundColor="#00000033"
                        VerticalOptions="Start">
                    <Label Text="👤"
                           FontSize="36"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label x:Name="NameLabel"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation" />
                    <Label x:Name="UsernameLabel"
                           TextColor="#E8E0FF"
                           FontSize="14"
                           Opacity="0.95" />
                    <Label x:Name="EmailLabel"
                           TextColor="#D8D0F0"
                           FontSize="13"
                           Opacity="0.9" />
                    <Border BackgroundColor="#FFFFFF33"
                            StrokeShape="RoundRectangle 20"
                            Padding="10,4"
                            HorizontalOptions="Start">
                        <Label x:Name="RoleLabel"
                               TextColor="White"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>

                <Grid Grid.Row="2" Grid.Column="1"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="8"
                      Margin="0,12,0,0">
                    <Border Grid.Column="0"
                            BackgroundColor="#00000033"
                            Stroke="#FFFFFF33"
                            StrokeShape="RoundRectangle 14"
                            Padding="8,8">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="StatActiveLabel" Text="0" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Aktif ödünç" TextColor="#E8E0FF" FontSize="11" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="#00000033"
                            Stroke="#FFFFFF33"
                            StrokeShape="RoundRectangle 14"
                            Padding="8,8">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="StatHistoryLabel" Text="0" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Okuduğum kitaplar" TextColor="#E8E0FF" FontSize="11" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2"
                            BackgroundColor="#00000033"
                            Stroke="#FFFFFF33"
                            StrokeShape="RoundRectangle 14"
                            Padding="8,8">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="StatFavoritesLabel" Text="0" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Favori" TextColor="#E8E0FF" FontSize="11" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <Label Text="Hesap"
                       TextColor="#9FA8DA"
                       FontSize="12"
                       FontAttributes="Bold"
                       Margin="4,0,0,0" />

                <Border BackgroundColor="#2B1B4F"
                        Stroke="#FFFFFF22"
                        StrokeShape="RoundRectangle 16"
                        Padding="4,6">
                    <VerticalStackLayout Spacing="2">
                        <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="🌓" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Tema" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                <Label Text="Açık, koyu veya sistem" TextColor="#B0B8D9" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#7C86B3" FontSize="22" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Theme_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#FFFFFF14" Margin="14,0" />

                        <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="🔔" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Bildirim ayarları" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                <Label Text="Teslim hatırlatmaları" TextColor="#B0B8D9" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#7C86B3" FontSize="22" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NotificationSettings_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#FFFFFF14" Margin="14,0" />

                        <Grid Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="📅" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Üyelik tarihi" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                <Label x:Name="MembershipDateLabel"
                                       Text="—"
                                       TextColor="#E8E0FF"
                                       FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#FFFFFF14" Margin="14,0" />

                        <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="🔖" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Favorilerim" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                <Label Text="Beğendiğin kitaplar" TextColor="#B0B8D9" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#7C86B3" FontSize="22" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Favorites_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#FFFFFF14" Margin="14,0" />

                        <Grid x:Name="AdminRow" Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="False">
                            <Label Text="🛡️" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Yönetim paneli" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                <Label Text="Kullanıcılar ve kitap yönetimi" TextColor="#B0B8D9" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#7C86B3" FontSize="22" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Admin_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView x:Name="AdminSeparator" HeightRequest="1" Color="#FFFFFF14" Margin="14,0" IsVisible="False" />

                        <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="🔑" FontSize="18" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Şifre değiştir" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                <Label Text="Hesap güvenliği" TextColor="#B0B8D9" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#7C86B3" FontSize="22" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ChangePass_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Çıkış yap"
                        TextColor="White"
                        BackgroundColor="#5B2D3A"
                        BorderColor="#FF8A80"
                        BorderWidth="1"
                        CornerRadius="14"
                        Padding="16,14"
                        FontAttributes="Bold"
                        Clicked="Logout_Clicked" />

                <Label Text="Ödünçteki kitaplarım"
                       TextColor="#9FA8DA"
                       FontSize="12"
                       FontAttributes="Bold"
                       Margin="4,8,0,0" />

                <CollectionView x:Name="ActiveBorrows"
                                SelectionMode="None"
                                HeightRequest="220"
                                EmptyView="Şu an ödünçte kitabın yok. Ana sayfadan kitap ödünç alabilirsin.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="14,12"
                                    BackgroundColor="#1E1638"
                                    Stroke="#7FC0FF44"
                                    StrokeShape="RoundRectangle 14">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Label Text="{Binding BookTitle}"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           FontSize="14"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1"
                                           Text="{Binding BookAuthor}"
                                           TextColor="#B0B8D9"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Grid.Row="2" Spacing="12">
                                        <Label Text="{Binding BorrowDate, StringFormat='Alınış: {0:dd.MM.yyyy}'}"
                                               TextColor="#9FA8DA"
                                               FontSize="11" />
                                        <Label Text="{Binding DueDate, StringFormat='Son gün: {0:dd.MM.yyyy}'}"
                                               TextColor="#FFD180"
                                               FontSize="11" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Grid.RowSpan="3"
                                                         Spacing="6"
                                                         VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 12"
                                                BackgroundColor="#00000044"
                                                Padding="10,6">
                                            <Label Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#E8EAF6"
                                                   MaxLines="2"
                                                   LineBreakMode="WordWrap" />
                                        </Border>
                                        <Button Text="İade et"
                                                FontSize="11"
                                                TextColor="White"
                                                BackgroundColor="#2E7D32"
                                                CornerRadius="10"
                                                Padding="10,4"
                                                Clicked="ReturnBorrow_Clicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Okuduğum kitaplar"
                       TextColor="#9FA8DA"
                       FontSize="12"
                       FontAttributes="Bold"
                       Margin="4,8,0,0" />

                <CollectionView x:Name="HistoryBorrows"
                                SelectionMode="None"
                                HeightRequest="200"
                                EmptyView="Henüz okuduğun kitap kaydı yok.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="14,12"
                                    BackgroundColor="#252238"
                                    Stroke="#FFFFFF18"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding BookTitle}"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           FontSize="14"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding BookAuthor}"
                                           TextColor="#B0B8D9"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding ReturnDate, StringFormat='İade tarihi: {0:dd.MM.yyyy}'}"
                                           TextColor="#A5D6A7"
                                           FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
