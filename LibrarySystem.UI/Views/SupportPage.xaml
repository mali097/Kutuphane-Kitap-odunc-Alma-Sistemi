<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LibrarySystem.UI.Views.SupportPage"
             Title="Yardım ve Destek"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="SupportTopGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF7A50" Offset="0.0" />
            <GradientStop Color="#C44B7A" Offset="0.45" />
            <GradientStop Color="#4A154B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Grid Background="{StaticResource SupportTopGradient}"
                  Padding="14,48,14,14"
                  ColumnDefinitions="Auto,*,Auto">
                <Button Text="←"
                        FontSize="20"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="4"
                        Clicked="Back_Clicked" />
                <Label Grid.Column="1"
                       Text="Yardım ve Destek"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text="⚙"
                        FontSize="18"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="8,4"
                        Clicked="Settings_Clicked" />
            </Grid>

            <Label Text="Sıkça Sorulanlar"
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColorLight}, Dark={StaticResource CardBackgroundColorDark}}"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                   FontSize="14"
                   FontAttributes="Bold"
                   Padding="16,12"
                   HorizontalTextAlignment="Center" />
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Padding="16,14,16,8">
            <VerticalStackLayout Spacing="14">

                <Border x:Name="CategoryBackBar"
                        IsVisible="False"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="0,0,0,4">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="‹"
                               FontSize="22"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPurpleColorLight}, Dark={StaticResource AccentPurpleColorDark}}"
                               VerticalOptions="Center" />
                        <Label x:Name="CategoryBackTitle"
                               Text=""
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                               VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CategoryBack_Tapped" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                </Border>

                <Border x:Name="SearchBarWrap"
                        Style="{StaticResource ThemedCard}"
                        Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="🔍"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}"
                               VerticalOptions="Center" />
                        <Entry x:Name="SearchEntry"
                               Placeholder="Nasıl yardımcı olabiliriz?"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                               BackgroundColor="Transparent"
                               FontSize="14"
                               VerticalOptions="Center"
                               TextChanged="Search_TextChanged" />
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="CategoryListContainer" Spacing="10" />
                <VerticalStackLayout x:Name="FaqAccordionContainer"
                                     Spacing="10"
                                     IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                Style="{StaticResource ThemedTabBar}"
                StrokeShape="RoundRectangle 24"
                Padding="14,10"
                Margin="14,8,14,14">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                <Button x:Name="TabHomeBtn" Grid.Column="0" Text="🏠&#10;Ana Sayfa"
                        Style="{StaticResource ThemedTabInactive}" Clicked="TabHome_Clicked" />
                <Button x:Name="TabCategoriesBtn" Grid.Column="1" Text="🗂️&#10;Kategoriler"
                        Style="{StaticResource ThemedTabInactive}" Clicked="TabCategories_Clicked" />
                <Button x:Name="TabFavoritesBtn" Grid.Column="2" Text="🔖&#10;Favorilerim"
                        Style="{StaticResource ThemedTabInactive}" Clicked="TabFavorites_Clicked" />
                <Button x:Name="TabNotificationsBtn" Grid.Column="3" Text="🔔&#10;Bildirimler"
                        Style="{StaticResource ThemedTabInactive}" Clicked="TabNotifications_Clicked" />
                <Button x:Name="TabSettingsBtn" Grid.Column="4" Text="⚙️&#10;Ayarlar"
                        Style="{StaticResource ThemedTabInactive}" Clicked="TabSettings_Clicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
