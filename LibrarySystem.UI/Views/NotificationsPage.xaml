<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LibrarySystem.UI.Views.NotificationsPage"
             Title="Bildirimler"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2F1B68" Offset="0.0" />
            <GradientStop Color="#B63B6E" Offset="0.55" />
            <GradientStop Color="#F29B3A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0"
              Background="{StaticResource HeaderGradient}"
              Padding="14,48,14,16"
              RowDefinitions="Auto,Auto"
              RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="←"
                        FontSize="20"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="4"
                        Clicked="Back_Clicked" />
                <Label Grid.Column="1"
                       Text="Bildirimler"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="10">
                <HorizontalStackLayout Spacing="20" Padding="4,0" HorizontalOptions="Center">
                    <Label x:Name="TabAll"
                           Text="Tümü"
                           FontAttributes="Bold"
                           TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TabAll_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabUnread"
                           Text="Okunmamış"
                           TextColor="#E8E0FF">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TabUnread_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabRead"
                           Text="Okunan"
                           TextColor="#E8E0FF">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TabRead_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
                <BoxView x:Name="TabUnderline"
                         HeightRequest="3"
                         WidthRequest="52"
                         Color="#FFB800"
                         HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <CollectionView Grid.Row="1"
                        x:Name="NotificationsList"
                        Margin="12,8,12,0"
                        SelectionMode="None"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}"
                        EmptyView="Henüz teslim veya iade bildirimin yok.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12"
                            Padding="14,12"
                            Style="{StaticResource ThemedCard}"
                            StrokeShape="RoundRectangle 16">
                        <Border.Shadow>
                            <Shadow Brush="#00000018" Offset="0,4" Radius="12" Opacity="0.35" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                            <Border Grid.RowSpan="2"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{Binding IconBackground}"
                                    VerticalOptions="Start">
                                <Label Text="{Binding IconGlyph}"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                   FontSize="15" />
                            <Label Grid.Column="2"
                                   Text="{Binding RelativeTimeText}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}"
                                   FontSize="12"
                                   VerticalOptions="Start" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Detail}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}"
                                   FontSize="13"
                                   LineBreakMode="WordWrap" />
                            <Ellipse Grid.Row="2"
                                     Grid.Column="2"
                                     WidthRequest="10"
                                     HeightRequest="10"
                                     Fill="{Binding StatusDotColor}"
                                     HorizontalOptions="End"
                                     VerticalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2"
                Style="{StaticResource ThemedTabBar}"
                StrokeShape="RoundRectangle 24"
                Padding="14,10"
                Margin="14,8,14,14">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                <Button x:Name="TabHomeBtn" Grid.Column="0" Text="🏠&#10;Ana Sayfa" Style="{StaticResource ThemedTabInactive}" Clicked="TabHome_Clicked" />
                <Button x:Name="TabCategoriesBtn" Grid.Column="1" Text="🗂️&#10;Kategoriler" Style="{StaticResource ThemedTabInactive}" Clicked="TabCategories_Clicked" />
                <Button x:Name="TabFavoritesBtn" Grid.Column="2" Text="🔖&#10;Favorilerim" Style="{StaticResource ThemedTabInactive}" Clicked="TabFavorites_Clicked" />
                <Button x:Name="TabNotificationsBtn" Grid.Column="3" Text="🔔&#10;Bildirimler" Style="{StaticResource ThemedTabInactive}" />
                <Button x:Name="TabSettingsBtn" Grid.Column="4" Text="⚙️&#10;Ayarlar" Style="{StaticResource ThemedTabInactive}" Clicked="TabSettings_Clicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
