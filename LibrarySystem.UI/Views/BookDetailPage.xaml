<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LibrarySystem.UI.Controls"
             x:Class="LibrarySystem.UI.Views.BookDetailPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2F1B68" Offset="0.0" />
            <GradientStop Color="#B63B6E" Offset="0.55" />
            <GradientStop Color="#F29B3A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0"
              Background="{StaticResource HeaderGradient}"
              Padding="14,48,14,20">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="←"
                        FontSize="20"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="4"
                        Clicked="Back_Clicked" />
                <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
                <Button Grid.Column="2"
                        x:Name="FavoriteHeaderBtn"
                        Text="🔖"
                        FontSize="18"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="4"
                        Clicked="FavoriteHeader_Clicked" />
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,0,14,24" Spacing="16">

                <Border WidthRequest="130"
                        HeightRequest="180"
                        BackgroundColor="#2B1B4F"
                        Stroke="#FFFFFF33"
                        StrokeShape="RoundRectangle 14"
                        HorizontalOptions="Center"
                        Clip="RoundRectangle 14">
                    <controls:BookCoverImage x:Name="CoverView"
                                             PlaceholderFontSize="52" />
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="TitleLabel"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                           LineBreakMode="WordWrap" />
                    <Label x:Name="AuthorLabel"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}" />

                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                        <controls:StarRatingView x:Name="AverageRatingView"
                                                 StarSize="20" />
                        <Label x:Name="RatingLabel"
                               Text="—"
                               FontSize="13"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}"
                               FontAttributes="Bold" />
                        <Label x:Name="ReviewCountLabel"
                               Text="(0)"
                               FontSize="12"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="Center">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,4">
                            <Label x:Name="CategoryTagLabel"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentPurpleColorLight}, Dark={StaticResource AccentPurpleColorDark}}"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                        </Border>
                        <Label x:Name="StatusLabel"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="#2E7D32" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Border x:Name="UserRatingCard"
                        Style="{StaticResource ThemedCard}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Puanınız"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                        <Label Text="Bu kitaba verdiğiniz puanı seçin. Her kullanıcı kendi puanını verebilir."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                        <HorizontalStackLayout Spacing="10"
                                               HorizontalOptions="Center">
                            <controls:StarRatingView x:Name="MyRatingView"
                                                     StarSize="28"
                                                     IsInteractive="True"
                                                     RatingChanged="MyRatingView_RatingChanged" />
                            <Label x:Name="MyRatingLabel"
                                   Text="—"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                        </HorizontalStackLayout>
                        <Label x:Name="RatingStatusLabel"
                               IsVisible="False"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ThemedCard}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Kitap Bilgileri"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />

                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Label Text="👤" FontSize="16" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Yazar" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                                    <Label x:Name="InfoAuthorLabel" FontSize="14" FontAttributes="Bold" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}" />

                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Label Text="📊" FontSize="16" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Barkod Kodu" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                                    <Label x:Name="IsbnLabel" FontSize="14" FontAttributes="Bold" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}" />

                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Label Text="📂" FontSize="16" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Tür" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                                    <Label x:Name="CategoryLabel" FontSize="14" FontAttributes="Bold" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}" />

                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Label Text="📅" FontSize="16" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Yayınlanma Tarihi" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                                    <Label x:Name="YearLabel" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}" />

                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Label Text="📄" FontSize="16" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Sayfa Sayısı" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                                    <Label x:Name="PageLabel" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}" />

                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Label Text="🏢" FontSize="16" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Yayınevi" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                                    <Label x:Name="PublisherLabel" FontSize="14" FontAttributes="Bold" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}" />

                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                <Label Text="🌐" FontSize="16" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Dil" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                                    <Label Text="Türkçe" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ThemedCard}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Açıklama"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                        <Label x:Name="DescLabel"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}"
                               FontSize="14"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="AdminButtons" IsVisible="False" Spacing="10">
                    <Button Text="✏️ Düzenle"
                            BackgroundColor="#5E4BB6"
                            TextColor="White"
                            CornerRadius="14"
                            Clicked="Edit_Clicked" />
                    <Button Text="🗑️ Sil"
                            BackgroundColor="#D32F2F"
                            TextColor="White"
                            CornerRadius="14"
                            Clicked="Delete_Clicked" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="14,0,14,14" Spacing="0">
            <Button x:Name="FavoriteBtn"
                    Text="+  Favorilere Ekle"
                    BackgroundColor="#5E4BB6"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="52"
                    Clicked="FavoriteBtn_Clicked" />
            <Button x:Name="BorrowBtn"
                    Text="📚 Ödünç Al"
                    BackgroundColor="#FF6F00"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="48"
                    Margin="0,8,0,0"
                    Clicked="BorrowThis_Clicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
