<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LibrarySystem.UI.Views.SettingsPage"
             Title="Ayarlar"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F8">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2F1B68" Offset="0.0" />
            <GradientStop Color="#B63B6E" Offset="0.55" />
            <GradientStop Color="#F29B3A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0"
              Background="{StaticResource HeaderGradient}"
              Padding="14,48,14,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="←"
                        FontSize="20"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="4"
                        Clicked="Back_Clicked" />
                <Label Grid.Column="1"
                       Text="Ayarlar"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <Border BackgroundColor="White"
                        Stroke="#E8E4DC"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                BackgroundColor="#E8E0F5">
                            <Label Text="👤"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label x:Name="UsernameLabel"
                                   Text=""
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   TextColor="#1B1530" />
                            <Label x:Name="EmailLabel"
                                   Text=""
                                   TextColor="#6B6578"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E8E4DC"
                        StrokeShape="RoundRectangle 18"
                        Padding="4,6">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#EDE9FF" StrokeShape="RoundRectangle 10">
                                <Label Text="👤" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Profil Bilgileri" TextColor="#1B1530" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#C5C0D8" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ProfileInfo_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0EEF5" Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#EDE9FF" StrokeShape="RoundRectangle 10">
                                <Label Text="🔑" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Şifre Değiştir" TextColor="#1B1530" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#C5C0D8" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ChangePassword_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0EEF5" Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#EDE9FF" StrokeShape="RoundRectangle 10">
                                <Label Text="✉️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="E-posta Adresi" TextColor="#1B1530" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#C5C0D8" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Email_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0EEF5" Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#EDE9FF" StrokeShape="RoundRectangle 10">
                                <Label Text="🌓" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Görünüm" TextColor="#1B1530" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#C5C0D8" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Appearance_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0EEF5" Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#EDE9FF" StrokeShape="RoundRectangle 10">
                                <Label Text="ℹ️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Hakkımızda" TextColor="#1B1530" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#C5C0D8" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="About_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0EEF5" Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#EDE9FF" StrokeShape="RoundRectangle 10">
                                <Label Text="❓" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Yardım ve Destek" TextColor="#1B1530" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#C5C0D8" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Help_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                BackgroundColor="#F3F3F6"
                StrokeShape="RoundRectangle 24"
                Padding="14,10"
                Margin="14,8,14,14">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Text="🏠&#10;Ana Sayfa" BackgroundColor="Transparent" TextColor="#6C6F7A" FontSize="11" Clicked="TabHome_Clicked" />
                <Button Grid.Column="1" Text="🗂️&#10;Kategoriler" BackgroundColor="Transparent" TextColor="#6C6F7A" FontSize="11" Clicked="TabCategories_Clicked" />
                <Button Grid.Column="2" Text="🔖&#10;Favorilerim" BackgroundColor="Transparent" TextColor="#6C6F7A" FontSize="11" Clicked="TabFavorites_Clicked" />
                <Button Grid.Column="3" Text="🔔&#10;Bildirimler" BackgroundColor="Transparent" TextColor="#6C6F7A" FontSize="11" Clicked="TabNotifications_Clicked" />
                <Button Grid.Column="4" Text="⚙️&#10;Ayarlar" BackgroundColor="#FFFFFF" TextColor="#5E4BB6" FontAttributes="Bold" CornerRadius="18" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
