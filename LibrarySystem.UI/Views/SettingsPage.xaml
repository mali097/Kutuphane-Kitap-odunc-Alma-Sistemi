<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LibrarySystem.UI.Views.SettingsPage"
             Title="Ayarlar"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2F1B68" Offset="0.0" />
            <GradientStop Color="#B63B6E" Offset="0.55" />
            <GradientStop Color="#F29B3A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0"
              Background="{StaticResource HeaderGradient}"
              Padding="14,48,14,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="←"
                        FontSize="20"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="4"
                        Clicked="Back_Clicked" />
                <Label Grid.Column="1"
                       Text="Ayarlar"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <Border Style="{StaticResource ThemedCard}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}">
                            <Label Text="👤"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label x:Name="UsernameLabel"
                                   Text=""
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                            <Label x:Name="EmailLabel"
                                   Text=""
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ThemedCard}"
                        StrokeShape="RoundRectangle 18"
                        Padding="4,6">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 10">
                                <Label Text="👤" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Profil Bilgileri"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                   FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentChevronColorLight}, Dark={StaticResource AccentChevronColorDark}}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ProfileInfo_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}"
                                 Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 10">
                                <Label Text="🔑" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Şifre Değiştir"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                   FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentChevronColorLight}, Dark={StaticResource AccentChevronColorDark}}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ChangePassword_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}"
                                 Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 10">
                                <Label Text="✉️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="E-posta Adresi"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                   FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentChevronColorLight}, Dark={StaticResource AccentChevronColorDark}}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Email_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}"
                                 Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 10">
                                <Label Text="🌓" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Tema"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                   FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentChevronColorLight}, Dark={StaticResource AccentChevronColorDark}}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Theme_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}"
                                 Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 10">
                                <Label Text="ℹ️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Hakkımızda"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                   FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentChevronColorLight}, Dark={StaticResource AccentChevronColorDark}}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="About_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource DividerColorLight}, Dark={StaticResource DividerColorDark}}"
                                 Margin="14,0" />

                        <Grid Padding="14,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftPurpleColorLight}, Dark={StaticResource AccentSoftPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 10">
                                <Label Text="❓" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Yardım ve Destek"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                   FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentChevronColorLight}, Dark={StaticResource AccentChevronColorDark}}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Help_Tapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                Style="{StaticResource ThemedTabBar}"
                StrokeShape="RoundRectangle 24"
                Padding="14,10"
                Margin="14,8,14,14">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                <Button x:Name="TabHomeBtn" Grid.Column="0" Text="🏠&#10;Ana Sayfa"
                        Style="{StaticResource ThemedTabInactive}" Clicked="TabHome_Clicked" />
                <Button x:Name="TabCategoriesBtn" Grid.Column="1" Text="🗂️&#10;Kategoriler"
                        Style="{StaticResource ThemedTabInactive}" Clicked="TabCategories_Clicked" />
                <Button x:Name="TabFavoritesBtn" Grid.Column="2" Text="🔖&#10;Favorilerim"
                        Style="{StaticResource ThemedTabInactive}" Clicked="TabFavorites_Clicked" />
                <Button x:Name="TabNotificationsBtn" Grid.Column="3" Text="🔔&#10;Bildirimler"
                        Style="{StaticResource ThemedTabInactive}" Clicked="TabNotifications_Clicked" />
                <Button x:Name="TabSettingsBtn" Grid.Column="4" Text="⚙️&#10;Ayarlar"
                        Style="{StaticResource ThemedTabInactive}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
