<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LibrarySystem.UI.Controls"
             x:Class="LibrarySystem.UI.Views.RegisterPage"
             Title="Kayıt Ol"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F1F8">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#4A4458" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F3F1F8" />
            <Setter Property="Stroke" Value="#E6E2EE" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinimumHeightRequest" Value="52" />
        </Style>
    </ContentPage.Resources>

    <Grid BackgroundColor="#F3F1F8">
        <controls:AuthPageHeader x:Name="AuthHeader"
                                 Title="Kayıt Ol"
                                 Subtitle="Yeni hesap oluşturarak kitap dünyamıza katılın"
                                 Illustration="Register"
                                 ShowBackButton="True"
                                 BackClicked="AuthHeader_BackClicked"
                                 VerticalOptions="Start" />

        <Border Margin="0,212,0,0"
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28,28,0,0"
                Padding="22,24,22,20"
                VerticalOptions="Fill">
            <ScrollView>
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ad Soyad" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="👤"
                                       FontSize="16"
                                       TextColor="#6B46C1"
                                       VerticalOptions="Center" />
                                <Entry x:Name="FullNameEntry"
                                       Grid.Column="1"
                                       Placeholder="Adınızı ve soyadınızı girin"
                                       PlaceholderColor="#A09BAE"
                                       TextColor="#1B1530"
                                       BackgroundColor="Transparent"
                                       ReturnType="Next" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-posta" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="✉"
                                       FontSize="16"
                                       TextColor="#6B46C1"
                                       VerticalOptions="Center" />
                                <Entry x:Name="EmailEntry"
                                       Grid.Column="1"
                                       Placeholder="ornek@email.com"
                                       PlaceholderColor="#A09BAE"
                                       TextColor="#1B1530"
                                       Keyboard="Email"
                                       BackgroundColor="Transparent"
                                       ReturnType="Next" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Şifre" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Text="🔒"
                                       FontSize="16"
                                       TextColor="#6B46C1"
                                       VerticalOptions="Center" />
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="1"
                                       Placeholder="Şifrenizi oluşturun"
                                       PlaceholderColor="#A09BAE"
                                       TextColor="#1B1530"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       ReturnType="Done" />
                                <Button x:Name="TogglePasswordButton"
                                        Grid.Column="2"
                                        Text="👁"
                                        FontSize="16"
                                        TextColor="#8A8498"
                                        BackgroundColor="Transparent"
                                        Padding="6,4"
                                        VerticalOptions="Center"
                                        Clicked="TogglePassword_Clicked" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Label x:Name="ErrorLabel"
                           Text=""
                           IsVisible="False"
                           TextColor="#D32F2F"
                           FontSize="12"
                           HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="Auto,*" IsVisible="False" x:Name="BusyRow">
                        <ActivityIndicator x:Name="BusyIndicator"
                                           Grid.Column="0"
                                           IsRunning="False"
                                           Color="#6B46C1" />
                        <Label x:Name="BusyText"
                               Grid.Column="1"
                               Text="Kayıt oluşturuluyor..."
                               TextColor="#6B6578"
                               FontSize="12"
                               VerticalOptions="Center"
                               Margin="10,0,0,0" />
                    </Grid>

                    <Button x:Name="RegisterButton"
                            Text="Kayıt Ol"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            BackgroundColor="#6B46C1"
                            CornerRadius="16"
                            Padding="16,14"
                            Margin="0,4,0,0"
                            Clicked="Register_Clicked" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,8,0,0">
                        <Label Text="Zaten hesabın var mı?"
                               TextColor="#6B6578"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Button Text="Giriş Yap"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#6B46C1"
                                BackgroundColor="Transparent"
                                Padding="0"
                                Clicked="GoLogin_Clicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
