<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LibrarySystem.UI.Controls"
             x:Class="LibrarySystem.UI.Views.MainPage"
             Title="Ana Sayfa">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2F1B68" Offset="0.0" />
            <GradientStop Color="#B63B6E" Offset="0.55" />
            <GradientStop Color="#F29B3A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Geniş arama -->
        <Grid Grid.Row="0" Padding="14,14,14,10" Background="{StaticResource HeaderGradient}"
              ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">

            <Border Grid.Row="0" Grid.Column="0"
                    Stroke="#FFFFFF33"
                    BackgroundColor="#00000022"
                    StrokeShape="RoundRectangle 20"
                    Padding="12,10"
                    MinimumHeightRequest="56">
                <SearchBar x:Name="KitapSearchBar"
                           Placeholder="Kitap adı veya yazar ara"
                           TextColor="White"
                           PlaceholderColor="#E8E0FF"
                           BackgroundColor="Transparent"
                           CancelButtonColor="White"
                           FontSize="16"
                           HeightRequest="44"
                           VerticalOptions="Center"
                           TextChanged="SearchBar_TextChanged" />
            </Border>

            <Border Grid.Row="0" Grid.Column="1"
                    BackgroundColor="#5B4CCF"
                    StrokeShape="RoundRectangle 14"
                    Padding="10,8">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 13" BackgroundColor="#FFFFFF33">
                        <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label x:Name="ProfileUsernameLabel"
                           Text="Profil"
                           TextColor="White"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Profile_Clicked" />
                </Border.GestureRecognizers>
            </Border>

            <Label x:Name="WelcomeLabel"
                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   Text=""
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="14" />
        </Grid>

        <Border x:Name="SearchResultsPanel"
                Grid.Row="1"
                IsVisible="False"
                Margin="14,0,14,8"
                Style="{StaticResource ThemedCard}"
                StrokeShape="RoundRectangle 16"
                Padding="12">
            <VerticalStackLayout Spacing="8">
                <Label Text="Arama sonuçları"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                <Label x:Name="SearchEmptyLabel"
                       IsVisible="False"
                       Text="Eşleşen kitap bulunamadı."
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}" />
                <CollectionView x:Name="SearchResultsCollection"
                                MaximumHeightRequest="260"
                                SelectionMode="Single"
                                SelectionChanged="SearchResult_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8"
                                    Margin="0,0,0,6"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SubBackgroundColorLight}, Dark={StaticResource SubBackgroundColorDark}}"
                                    StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}" />
                                        <Label Text="{Binding Author}"
                                               FontSize="12"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="→"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource AccentPurpleColorLight}, Dark={StaticResource AccentPurpleColorDark}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Ana sayfa içeriği -->
        <ScrollView x:Name="HomePanel" Grid.Row="2">
            <VerticalStackLayout Padding="14" Spacing="14">

                <Border Style="{StaticResource ThemedCardAlt}"
                        StrokeShape="RoundRectangle 20"
                        Padding="14"
                        MinimumHeightRequest="280">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Border WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentPurpleColorLight}, Dark={StaticResource AccentPurpleColorDark}}"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="✍️" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Yazar düşünceleri"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="Yazarların görüşleri ve önerileri"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Button x:Name="AddRecommendationButton"
                                    Grid.Column="2"
                                    Text="+"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    IsVisible="False"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentPurpleColorLight}, Dark={StaticResource AccentPurpleColorDark}}"
                                    VerticalOptions="Center"
                                    Clicked="AddRecommendation_Clicked" />
                        </Grid>

                        <CollectionView x:Name="QuotesCollection"
                                        ItemsLayout="VerticalList"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ThemedCard}"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                            <Border WidthRequest="40" HeightRequest="40"
                                                    StrokeShape="RoundRectangle 20"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentPurpleColorLight}, Dark={StaticResource AccentPurpleColorDark}}">
                                                <Label Text="👤" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Author}"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                                   Margin="10,0,0,0"/>
                                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4" Margin="10,4,0,0">
                                                <Label Text="{Binding BookTitle}"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource AccentPurpleColorLight}, Dark={StaticResource AccentPurpleColorDark}}" />
                                                <Label Text="{Binding Text}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}"
                                                       FontSize="12"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="PopularBooksSection"
                        Style="{StaticResource ThemedCardAlt}"
                        StrokeShape="RoundRectangle 20"
                        Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Border WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="#FFB800"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="🏆" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="En çok okunan kitaplar"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="En yüksek puanlı 5 kitap"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <CollectionView x:Name="PopularCollection"
                                        ItemsLayout="VerticalList"
                                        SelectionMode="Single"
                                        SelectionChanged="PopularBook_SelectionChanged">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{Binding RowColor}"
                                            Stroke="#FFFFFF55"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                            <Border WidthRequest="26" HeightRequest="26"
                                                    StrokeShape="RoundRectangle 13"
                                                    BackgroundColor="#00000022">
                                                <Label Text="{Binding Rank}"
                                                       TextColor="White"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                            <Border Grid.Column="1"
                                                    WidthRequest="46" HeightRequest="60"
                                                    StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="#00000022"
                                                    Clip="RoundRectangle 10">
                                                <controls:BookCoverImage BookId="{Binding BookId}"
                                                                         PlaceholderFontSize="22" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" FontSize="13" />
                                                <Label Text="{Binding Author}" TextColor="#FFFFFFCC" FontSize="11" />
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="★" TextColor="#FFB800" FontSize="14" />
                                                    <Label Text="{Binding Rating}" TextColor="#FFFFFFEE" FontSize="12" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="3"
                                                    BackgroundColor="#5E4BB6"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,8"
                                                    VerticalOptions="Center">
                                                <Label Text="🔖" TextColor="White" FontSize="14"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ActiveBorrowsSection"
                        BackgroundColor="#1E3A5F"
                        Stroke="#7FC0FF55"
                        StrokeShape="RoundRectangle 18"
                        Padding="14"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="📖 Ödünçteki kitaplarım"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="15"/>
                            <Label x:Name="ActiveBorrowCountLabel"
                                   Grid.Column="1"
                                   Text="0"
                                   TextColor="#B7D2FF"
                                   FontSize="12"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <CollectionView x:Name="ActiveBorrowsCollectionView"
                                        SelectionMode="None"
                                        EmptyView="Şu an ödünçte kitabın yok."
                                        ItemsLayout="VerticalList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#00000033"
                                            Stroke="#7FC0FF44"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                            <Label Text="{Binding BookTitle}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="13"/>
                                            <Label Grid.Row="1"
                                                   Text="{Binding BookAuthor}"
                                                   TextColor="#B0B8D9"
                                                   FontSize="11"/>
                                            <HorizontalStackLayout Grid.Row="2" Spacing="10">
                                                <Label Text="{Binding BorrowDate, StringFormat='Alınış: {0:dd.MM.yyyy}'}"
                                                       TextColor="#9FA8DA"
                                                       FontSize="10"/>
                                                <Label Text="{Binding DueDate, StringFormat='Son gün: {0:dd.MM.yyyy}'}"
                                                       TextColor="#FFD180"
                                                       FontSize="10"
                                                       FontAttributes="Bold"/>
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1"
                                                   Grid.RowSpan="3"
                                                   Text="{Binding Status}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#E8EAF6"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="End"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Profilde tümünü gör →"
                                BackgroundColor="Transparent"
                                TextColor="#B7D2FF"
                                FontSize="12"
                                Clicked="Profile_Clicked"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Kategoriler sekmesi -->
        <ScrollView x:Name="CategoriesPanel"
                    Grid.Row="2"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}">
            <VerticalStackLayout Padding="14,10" Spacing="12">
                <Grid ColumnDefinitions="*,Auto" Padding="2,0">
                    <Label Text="Tüm Kategoriler"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColorLight}, Dark={StaticResource TextPrimaryColorDark}}"
                           VerticalOptions="Center" />
                    <Label x:Name="CategoryCountLabel"
                           Grid.Column="1"
                           Text="22 kategori"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColorLight}, Dark={StaticResource TextSecondaryColorDark}}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid x:Name="CategoriesGrid" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="3"
                Style="{StaticResource ThemedTabBar}"
                StrokeShape="RoundRectangle 24"
                Padding="14,10"
                Margin="14,8,14,14">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                <Button x:Name="TabHomeBtn"
                        Grid.Column="0"
                        Text="🏠&#10;Ana Sayfa"
                        Style="{StaticResource ThemedTabInactive}"
                        Clicked="TabHome_Clicked" />
                <Button x:Name="TabCategoriesBtn"
                        Grid.Column="1"
                        Text="🗂️&#10;Kategoriler"
                        Style="{StaticResource ThemedTabInactive}"
                        Clicked="TabCategories_Clicked" />
                <Button x:Name="TabFavoritesBtn"
                        Grid.Column="2"
                        Text="🔖&#10;Favorilerim"
                        Style="{StaticResource ThemedTabInactive}"
                        Clicked="Favorites_Clicked" />
                <Button x:Name="TabNotificationsBtn"
                        Grid.Column="3"
                        Text="🔔&#10;Bildirimler"
                        Style="{StaticResource ThemedTabInactive}"
                        Clicked="TabNotifications_Clicked" />
                <Button x:Name="TabSettingsBtn"
                        Grid.Column="4"
                        Text="⚙️&#10;Ayarlar"
                        Style="{StaticResource ThemedTabInactive}"
                        Clicked="TabSettings_Clicked" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
